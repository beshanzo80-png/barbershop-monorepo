# ==================== DATABASE ====================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbershop?schema=public"

# ==================== AUTH ====================
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ==================== PAYMENTS (İyzico) ====================
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# ==================== SMS (Netgsm) ====================
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER="BRBRAL"

# ==================== PUSH NOTIFICATIONS (Web Push / VAPID) ====================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@premiumbarber.com"

# ==================== EMAIL (Resend) ====================
RESEND_API_KEY=""
EMAIL_FROM="Premium Barber <noreply@premiumbarber.com>"

# ==================== EXTERNAL APIs ====================
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# ==================== SHOP SETTINGS ====================
NEXT_PUBLIC_SHOP_NAME="Premium Barber"
NEXT_PUBLIC_SHOP_PHONE="+905551234567"
NEXT_PUBLIC_SHOP_ADDRESS="İstanbul, Kadıköy, Moda Cd. No:123"
NEXT_PUBLIC_SHOP_WHATSAPP="+905551234567"

# ==================== FEATURE FLAGS ====================
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_PUSH=true
NEXT_PUBLIC_ENABLE_BIOMETRIC=true
NEXT_PUBLIC_ENABLE_WALLET=true